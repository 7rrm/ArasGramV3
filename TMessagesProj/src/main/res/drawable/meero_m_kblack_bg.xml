<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="290" android:type="linear"
                android:startColor="#0A0A0E" android:centerColor="#141420" android:endColor="#23243A" />
        </shape>
    </item>
    <item android:gravity="top|left" android:top="-20dp" android:left="-20dp" android:right="40dp" android:bottom="40dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="54dp"
                android:startColor="#332F3F6B" android:endColor="#002F3F6B" />
        </shape>
    </item>
</layer-list>
