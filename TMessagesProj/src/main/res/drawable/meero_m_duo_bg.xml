<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="290" android:type="linear"
                android:startColor="#FFFFFF" android:centerColor="#F2F2F6" android:endColor="#DCDCE4" />
        </shape>
    </item>
    <item android:gravity="top|left" android:top="-20dp" android:left="-20dp" android:right="40dp" android:bottom="40dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="52dp"
                android:startColor="#55FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
